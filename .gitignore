# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# e2e 테스트 (하드코딩 credentials 포함)
e2e_*.mjs

# Claude 세션/메모리 파일
.claude/

# 디버깅 산출물
debug_login.html
debug_login.png

# Playwright 캐시 및 결과물
playwright-report/
test-results/

# 참고 자료 파일
*.xlsx
~$*.xlsx
